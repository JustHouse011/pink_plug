rules_version = '2';

// The app never talks to Firestore directly — every request goes through
// pink_plug_backend's API, which uses the Admin SDK (and so ignores these
// rules entirely). Client SDK access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
